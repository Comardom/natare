---
import { getCollection } from 'astro:content'
import ThemeToggle from '@/components/blog/ThemeToggle.astro'
import ScrollablePageLayout from '@/layouts/ScrollablePageLayout.astro'
import '/src/css/blog.css'

interface Props {
    initialView: 'usus' | 'litterae'
}

const { initialView } = Astro.props
const isLitteraeOpen = initialView === 'litterae'
const ususPosts = (await getCollection('usus', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const litteraePosts = (await getCollection('litterae', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

async function litteraeExcerpt(post: (typeof litteraePosts)[number]) {
    if (post.data.excerpt) return post.data.excerpt

    return (post.body ?? '')
        .split('\n')
        .map((line) => line.trim())
        .filter((line) => line && !line.startsWith('#'))
        .slice(0, 3)
        .join('\n')
}

const litteraeCards = await Promise.all(litteraePosts.map(async (post) => ({
    post,
    excerpt: await litteraeExcerpt(post),
})))

function isPostOutdated(post: (typeof ususPosts)[number]) {
    const referenceDate = post.data.updatedDate ?? post.data.pubDate
    const oneYearAgo = new Date()
    oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1)
    return referenceDate < oneYearAgo
}
---

<ScrollablePageLayout title="Comardom的博客 | 一片星瓦">
    <main class:list={['content-page', { 'is-litterae-open': isLitteraeOpen }]}>
        <section class="usus-scene" aria-hidden={isLitteraeOpen}>
            <div class="usus-scroller">
                <aside class="usus-intro">
                    <h1>一片星瓦</h1>
                    <p>当我进入纯粹的黑暗时，天就是永远晴朗的。因为没有那些嘈杂的光色污染，即使是灰蒙蒙的天，也变得严谨可爱了起来。</p>
                    <button class="litterae-toggle" type="button" aria-label="切换文集" aria-expanded="false">
                        <img src="/go-black.svg" class="icon icon-go-black" alt="" />
                        <img src="/go-white.svg" class="icon icon-go-white" alt="" />
                    </button>
                </aside>
                <section class="usus-flow" aria-label="技术博客列表">
                    <div class="usus-list">
                        {ususPosts.length ? ususPosts.map((post) => (
                            <article class="post-card">
                                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
                                <span class="post-author">作者：{post.data.author}</span>
                                {post.data.aiGenerated && <span class="ai-tag">AI 生成</span>}
                                {isPostOutdated(post) && <span class="outdated-tag">可能过时</span>}
                                <h2><a href={`/usus/${post.id}`}>{post.data.title}</a></h2>
                                {post.data.description && <p>{post.data.description}</p>}
                            </article>
                        )) : <p class="empty-state">暂时还没有文章。</p>}
                    </div>
                </section>
            </div>
        </section>

        <section class="litterae-scene" aria-hidden={!isLitteraeOpen}>
            <section class="litterae-flow" aria-label="文集列表">
                <div class="litterae-list">
                    {litteraeCards.map(({ post, excerpt }) => (
                        <article class="post-card litterae-card">
                            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
                            <span class="post-author">作者：{post.data.author}</span>
                            {post.data.title !== '-' && <h2><a href={`/litterae/${post.id}`}>{post.data.title}</a></h2>}
                            {excerpt && <a class="litterae-excerpt-link" href={`/litterae/${post.id}`}>{excerpt}</a>}
                        </article>
                    ))}
                </div>
            </section>
            <aside class="litterae-sidebar">
                <h1>一片星瓦</h1>
                <p>当我进入纯粹的黑暗时，天就是永远晴朗的。因为没有那些嘈杂的光色污染，即使是灰蒙蒙的天，也变得严谨可爱了起来。</p>
                <button class="litterae-toggle" type="button" aria-label="切换技术博客" aria-expanded="true">
                    <img src="/go-black.svg" class="icon icon-go-black" alt="" />
                    <img src="/go-white.svg" class="icon icon-go-white" alt="" />
                </button>
            </aside>
        </section>
    </main>
    <ThemeToggle />
    <script>
        import { gsap } from 'gsap'

        const page = document.querySelector<HTMLElement>('.content-page')
        const ususScene = document.querySelector<HTMLElement>('.usus-scene')
        const litteraeScene = document.querySelector<HTMLElement>('.litterae-scene')
        const toggles = document.querySelectorAll<HTMLButtonElement>('.litterae-toggle')

        if (page && ususScene && litteraeScene && toggles.length) {
            let scrollAnimation = 0
            let targetScrollLeft = 0
            let transition: gsap.core.Timeline | null = null

            const activeUsusScroller = () => ususScene.querySelector<HTMLElement>('.usus-scroller')

            const createSceneSnapshot = (scene: HTMLElement) => {
                const rect = scene.getBoundingClientRect()
                const snapshot = scene.cloneNode(true) as HTMLElement

                snapshot.setAttribute('aria-hidden', 'true')
                snapshot.classList.remove('usus-scene', 'litterae-scene')
                snapshot.classList.add('scene-snapshot')
                if (scene === litteraeScene) {
                    const sidebar = scene.querySelector<HTMLElement>('.litterae-sidebar')
                    const snapshotSidebar = snapshot.querySelector<HTMLElement>('.litterae-sidebar')

                    snapshot.classList.add('litterae-snapshot')
                    if (sidebar && snapshotSidebar) {
                        const sidebarRect = sidebar.getBoundingClientRect()
                        Object.assign(snapshotSidebar.style, {
                            position: 'absolute',
                            inset: `${sidebarRect.top - rect.top}px auto auto ${sidebarRect.left - rect.left}px`,
                            inlineSize: `${sidebarRect.width}px`,
                            blockSize: `${sidebarRect.height}px`,
                        })
                    }
                }
                Object.assign(snapshot.style, {
                    position: 'fixed',
                    inset: `${rect.top}px auto auto ${rect.left}px`,
                    zIndex: '50',
                    inlineSize: `${rect.width}px`,
                    blockSize: `${rect.height}px`,
                    margin: '0',
                    overflow: 'hidden',
                    pointerEvents: 'none',
                })
                document.body.append(snapshot)
                return snapshot
            }

            const setLitteraeOpen = (isOpen: boolean, updateUrl: boolean) => {
                if (transition?.isActive()) return

                const current = isOpen ? ususScene : litteraeScene
                const next = isOpen ? litteraeScene : ususScene
                const direction = isOpen ? 1 : -1
                const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce), (max-width: 40rem)').matches

                if (updateUrl) {
                    history.pushState({ view: isOpen ? 'litterae' : 'usus' }, '', isOpen ? '/litterae' : '/usus')
                }

                if (reducedMotion) {
                    page.classList.toggle('is-litterae-open', isOpen)
                    current.setAttribute('aria-hidden', 'true')
                    next.setAttribute('aria-hidden', 'false')
                    toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(isOpen)))
                    window.scrollTo(0, 0)
                    return
                }

                const snapshot = createSceneSnapshot(current)
                page.classList.toggle('is-litterae-open', isOpen)
                current.setAttribute('aria-hidden', 'true')
                next.setAttribute('aria-hidden', 'false')
                toggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(isOpen)))
                window.scrollTo(0, 0)

                gsap.set(next, { autoAlpha: 1, x: -direction * window.innerWidth })
                transition = gsap.timeline({
                    defaults: { duration: 0.72, ease: 'power4.inOut' },
                    onComplete: () => {
                        snapshot.remove()
                        gsap.set(next, { clearProps: 'transform,opacity,visibility' })
                        transition = null
                    },
                })
                transition.to(snapshot, { x: direction * window.innerWidth, autoAlpha: 0 }, 0)
                transition.to(next, { x: 0, autoAlpha: 1 }, 0)
            }

            const handleWheel = (event: WheelEvent) => {
                if (!(event.target instanceof Element) || !event.target.closest('.content-page')) return
                if (page.classList.contains('is-litterae-open')) return
                if (window.matchMedia('(max-width: 40rem)').matches) return

                const scroller = activeUsusScroller()
                if (!scroller || scroller.scrollWidth <= scroller.clientWidth) return

                const multiplier = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16
                    : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? scroller.clientWidth : 1
                const distance = (event.deltaX || event.deltaY) * multiplier
                if (!distance) return

                event.preventDefault()
                const baseScrollLeft = scrollAnimation ? targetScrollLeft : scroller.scrollLeft
                targetScrollLeft = Math.min(
                    Math.max(baseScrollLeft + distance, 0),
                    scroller.scrollWidth - scroller.clientWidth,
                )
                const animate = () => {
                    const remaining = targetScrollLeft - scroller.scrollLeft
                    if (Math.abs(remaining) < 0.5) {
                        scroller.scrollLeft = targetScrollLeft
                        scrollAnimation = 0
                        return
                    }
                    scroller.scrollLeft += remaining * 0.2
                    scrollAnimation = requestAnimationFrame(animate)
                }
                if (!scrollAnimation) scrollAnimation = requestAnimationFrame(animate)
            }

            const toggleLitterae = () => setLitteraeOpen(!page.classList.contains('is-litterae-open'), true)
            const handlePopState = () => setLitteraeOpen(window.location.pathname === '/litterae', false)
            const dispose = () => {
                cancelAnimationFrame(scrollAnimation)
                transition?.kill()
                document.removeEventListener('wheel', handleWheel, { capture: true })
                toggles.forEach((toggle) => toggle.removeEventListener('click', toggleLitterae))
                window.removeEventListener('popstate', handlePopState)
                document.removeEventListener('astro:before-swap', dispose)
                window.removeEventListener('pagehide', dispose)
            }

            document.addEventListener('wheel', handleWheel, { capture: true, passive: false })
            toggles.forEach((toggle) => toggle.addEventListener('click', toggleLitterae))
            window.addEventListener('popstate', handlePopState)
            document.addEventListener('astro:before-swap', dispose)
            window.addEventListener('pagehide', dispose, { once: true })
        }
    </script>
</ScrollablePageLayout>
