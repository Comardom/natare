---
interface Props {
    author?: string
    pubDate: Date
    aiGenerated?: boolean
    mayBeOutdated?: boolean
}

const { author, pubDate, aiGenerated = false, mayBeOutdated = false } = Astro.props
---

<div class="article-byline">
    {author && (
        <>
            <span class="article-byline-item">作者：{author}</span>
            <span class="article-byline-sep" aria-hidden="true">·</span>
        </>
    )}
    <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN')}</time>
    {aiGenerated && <span class="ai-tag article-byline-tag">AI 生成</span>}
    {mayBeOutdated && <span class="outdated-tag article-byline-tag">可能过时</span>}
</div>
