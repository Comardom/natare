---
import ThemeToggle from '@/components/blog/ThemeToggle.astro'
import Busuanzi from '@/components/site/Busuanzi.astro'
import ArticleBackToggle from '@/components/article/ArticleBackToggle.astro'

interface Props {
    author?: string
    pubDate: Date
    aiGenerated?: boolean
    mayBeOutdated?: boolean
    backHref: string
}

const { author, pubDate, aiGenerated = false, mayBeOutdated = false, backHref } = Astro.props
---

<aside class="article-aside" aria-label="文章信息">
    <div class="article-glass">
        <div class="article-glass-info">
            <dl class="article-glass-meta">
                {author && (
                    <div>
                        <dt>作者</dt>
                        <dd>{author}</dd>
                    </div>
                )}
                <div>
                    <dt>发布日期</dt>
                    <dd>
                        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN')}</time>
                    </dd>
                </div>
                {aiGenerated && (
                    <div>
                        <dt>内容来源</dt>
                        <dd><span class="ai-tag">AI 生成</span></dd>
                    </div>
                )}
                {mayBeOutdated && (
                    <div>
                        <dt>内容状态</dt>
                        <dd><span class="outdated-tag">可能过时</span></dd>
                    </div>
                )}
            </dl>
            <Busuanzi scope="page" />
        </div>
        <div class="article-glass-actions">
            <ArticleBackToggle href={backHref} />
            <ThemeToggle />
        </div>
    </div>
</aside>
