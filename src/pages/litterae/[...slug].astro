---
import { getEntry, render } from 'astro:content'
import ArticleBackToggle from '@/components/article/ArticleBackToggle.astro'
import ArticleGlass from '@/components/article/ArticleGlass.astro'
import ArticleMobileMeta from '@/components/article/ArticleMobileMeta.astro'
import CodeCopy from '@/components/article/CodeCopy.astro'
import ThemeToggle from '@/components/blog/ThemeToggle.astro'
import Busuanzi from '@/components/site/Busuanzi.astro'
import ScrollablePageLayout from '@/layouts/ScrollablePageLayout.astro'
import '/src/css/blog.css'

const slug = Astro.params.slug
if (!slug) return Astro.redirect('/litterae', 302)

const post = await getEntry('litterae', slug)
if (!post || post.data.draft) return Astro.redirect('/litterae', 302)

const { Content } = await render(post)
const description = post.data.description ?? post.data.title
---

<ScrollablePageLayout
    title={`${post.data.title} | 一片星瓦`}
    description={description}
>
    <main class="article-page litterae-article-page">
        <article class="article-reading-column">
            <div class="article-reading-content">
                <header class="article-header">
                    <h1>{post.data.title}</h1>
                    <ArticleMobileMeta
                        author={post.data.author}
                        pubDate={post.data.pubDate}
                    />
                </header>

                <div class="article-prose">
                    <div class="prose">
                        <Content />
                    </div>
                </div>

                <footer class="article-footer">
                    <Busuanzi scope="page" />
                </footer>
            </div>
        </article>
        <ArticleGlass author={post.data.author} pubDate={post.data.pubDate} backHref="/litterae" />
    </main>
    <div class="article-float-actions">
        <ArticleBackToggle href="/litterae" />
        <ThemeToggle />
    </div>
    <CodeCopy />
</ScrollablePageLayout>
