---
import { getCollection } from 'astro:content'
import ThemeToggle from '@/components/blog/ThemeToggle.astro'
import ScrollablePageLayout from '@/layouts/ScrollablePageLayout.astro'
import '/src/css/blog.css'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

function isPostOutdated(post: (typeof posts)[number]) {
    const referenceDate = post.data.updatedDate ?? post.data.pubDate
    const oneYearAgo = new Date()
    oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1)
    return referenceDate < oneYearAgo
}
---

<ScrollablePageLayout title="Comardom的博客 | 一片星瓦">
    <main class="blog-page">
        <div class="blog-scroller">
            <aside class="blog-intro">
                <h1>一片星瓦</h1>
                <p>当我进入纯粹的黑暗时，天就是永远晴朗的。因为没有那些嘈杂的光色污染，即使是灰蒙蒙的天，也变得严谨可爱了起来。</p>
            </aside>

            <section class="post-area" aria-label="文章列表">
                <div class="post-list">
                    {posts.length ? posts.map((post) => (
                        <article class="post-card">
                            <time datetime={post.data.pubDate.toISOString()}>
                                {post.data.pubDate.toLocaleDateString('zh-CN')}
                            </time>
                            <span class="post-author">作者：{post.data.author}</span>
                            {post.data.aiGenerated && <span class="ai-tag">AI 生成</span>}
                            {isPostOutdated(post) && <span class="outdated-tag">可能过时</span>}
                            <h2>
                                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                            </h2>
                            {post.data.description && <p>{post.data.description}</p>}
                        </article>
                    )) : (
                        <p class="empty-state">暂时还没有文章。</p>
                    )}
                </div>
            </section>
        </div>
    </main>
    <ThemeToggle />
    <script>
        const scroller = document.querySelector<HTMLElement>('.blog-scroller')

        if (scroller) {
            const handleWheel = (event: WheelEvent) => {
                if (!(event.target instanceof Element) || !event.target.closest('.blog-page')) return
                if (window.matchMedia('(max-width: 40rem)').matches) return
                if (scroller.scrollWidth <= scroller.clientWidth) return

                const distance = event.deltaX || event.deltaY
                if (!distance) return

                event.preventDefault()
                scroller.scrollBy({ left: distance, top: 0, behavior: 'auto' })
            }

            const dispose = () => {
                document.removeEventListener('wheel', handleWheel, { capture: true })
                document.removeEventListener('astro:before-swap', dispose)
                window.removeEventListener('pagehide', dispose)
            }

            document.addEventListener('wheel', handleWheel, { capture: true, passive: false })
            document.addEventListener('astro:before-swap', dispose)
            window.addEventListener('pagehide', dispose, { once: true })
        }
    </script>
</ScrollablePageLayout>
